# === NOUR — TROUSSEAU DE CLÉS ===
# Ceci est le modèle vide. Il peut être déposé sur un dépôt de code.
# Pour utiliser : copier ce fichier en ".env", remplir les valeurs, et garder ".env" sur le serveur uniquement.
# Le fichier ".env" ne doit jamais être partagé ni envoyé sur un dépôt de code.

# -------------------------------------------------------
# GMAIL — ENVOI ET LECTURE
# -------------------------------------------------------

# Adresse Gmail depuis laquelle Nour envoie les rappels et lit les réponses.
GMAIL_USER=

# Mot de passe d'application Gmail (16 caractères, sans espaces).
# À générer dans : compte Google → Sécurité → Mots de passe des applications.
# Ce n'est pas ton mot de passe Gmail habituel — c'est un mot de passe spécial pour cette application.
GMAIL_APP_PASSWORD=

# -------------------------------------------------------
# DESTINATAIRE
# -------------------------------------------------------

# Adresse email où Nour envoie les rappels (peut être la même que GMAIL_USER ou une autre adresse).
RECIPIENT_EMAIL=

# -------------------------------------------------------
# IDENTITÉ DE L'EXPÉDITEUR
# -------------------------------------------------------

# Nom affiché dans les emails envoyés par Nour (ex. : "Nour" ou "Nour — Agent du Rappel").
SENDER_NAME=Nour

# -------------------------------------------------------
# RÉGLAGES DE NOUR
# -------------------------------------------------------

# Délai de rappel avant la prière, en minutes. Valeur retenue : 20.
REMINDER_DELAY_MINUTES=20

# Méthode de calcul AlAdhan. Valeur retenue : 99 (custom).
PRAYER_CALC_METHOD=99

# Paramètres de la méthode custom : Fajr=12° (angle UOIF France), Isha=90 min fixes après Maghrib.
PRAYER_METHOD_SETTINGS=12,null,90 min

# École juridique pour le calcul du 'Asr : 0 = Shafi'i (ombre simple), 1 = Hanafi.
PRAYER_SCHOOL=0

# Correction par prière en minutes (ordre AlAdhan : Imsak,Fajr,Sunrise,Dhuhr,Asr,Sunset,Maghrib,Isha,Midnight).
# Dhuhr +4 et Asr -4 corrigent un écart systématique vérifié sur 4 saisons.
PRAYER_TUNE=0,-3,0,4,-4,0,0,0,0

# -------------------------------------------------------
# POSITION PAR DÉFAUT
# -------------------------------------------------------

# Utilisée au démarrage, avant tout changement de ville.
DEFAULT_CITY=Villefranche-sur-Saone
DEFAULT_COUNTRY=France
DEFAULT_LATITUDE=45.9800
DEFAULT_LONGITUDE=4.7122
DEFAULT_TIMEZONE=Europe/Paris
